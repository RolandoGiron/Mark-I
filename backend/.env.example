# Environment Configuration
ENVIRONMENT=development  # development, staging, production

# Application
APP_NAME="Mark-I - Sistema de Gestión de Obras"
APP_VERSION=2.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Para desarrollo (SQLite)
DATABASE_URL=sqlite:///./obras.db

# Para producción (PostgreSQL)
# DATABASE_URL=postgresql://obras_user:obras_pass@localhost:5432/obras

# Security
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Storage Configuration
STORAGE_TYPE=local  # local o minio
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB en bytes

# MinIO Configuration (cuando STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=obras-facturas
MINIO_SECURE=False

# Telegram Bot (Fase 2) ✅
# Obtén tu token hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN
# Para modo webhook (producción)
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
# Para modo polling (desarrollo) deja vacío TELEGRAM_WEBHOOK_URL

# OCR Configuration (Fase 3)
# OCR_ENGINE=tesseract  # tesseract o easyocr
# TESSERACT_PATH=/usr/bin/tesseract
# OCR_LANGUAGES=spa,eng

# Speech-to-Text Configuration (Fase 3)
# STT_ENGINE=whisper  # whisper o wav2vec2
# WHISPER_MODEL=base  # tiny, base, small, medium, large
# WHISPER_DEVICE=cpu  # cpu o cuda

# Celery Configuration (Fase 2/3)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Redis Configuration (Fase 4)
# REDIS_URL=redis://localhost:6379/0
